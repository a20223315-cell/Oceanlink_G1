<%@ page pageEncoding="UTF-8" %><%@ include file="cabecera.jspf" %>
<div class="back-row"><a class="secondary-button" href="UsuarioServlet">Volver a usuarios</a></div><div class="page-heading"><h1>Detalle de usuario</h1></div>
<article class="panel"><div class="user-profile-hero"><div class="user-avatar" data-initials><c:out value="${registro.nombre}"/></div><div class="user-profile-heading"><h3><c:out value="${registro.nombre}"/></h3><p><c:out value="${registro.rolNombre}"/></p><div class="user-country-state"><span class="user-country"><img class="country-flag" src="${pageContext.request.contextPath}/assets/flags/${fn:toLowerCase(registro.paisCodigo)}.svg" alt=""> <c:out value="${registro.paisNombre}"/></span><span class="status ${registro.estadoClase}">${registro.estadoTexto}</span></div></div></div>
<div class="user-profile-grid"><div class="profile-data"><i class="fa-regular fa-envelope" aria-hidden="true"></i><span><small>CORREO CORPORATIVO</small><strong><c:out value="${registro.correo}"/></strong></span></div><div class="profile-data"><i class="fa-regular fa-envelope" aria-hidden="true"></i><span><small>CORREO PERSONAL</small><strong><c:out value="${empty registro.correoPersonal ? 'Sin registrar' : registro.correoPersonal}"/></strong></span></div><div class="profile-data"><i class="fa-solid fa-phone" aria-hidden="true"></i><span><small>CELULAR</small><strong class="phone-summary"><span class="phone-prefix"><img class="country-flag" src="${pageContext.request.contextPath}/assets/flags/${fn:toLowerCase(registro.telefonoRegion)}.svg" alt="${registro.telefonoRegion}"><span><c:out value="${registro.prefijo}"/></span></span><span><c:out value="${registro.telefonoLocal}"/></span></strong></span></div><div class="profile-data"><i class="fa-regular fa-calendar" aria-hidden="true"></i><span><small>FECHA DE INGRESO</small><strong><c:out value="${registro.fechaIngresoTexto}"/></strong></span></div><div class="profile-data"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i><span><small>ÚLTIMO ACCESO</small><strong><c:out value="${registro.ultimoAccesoTexto}"/></strong></span></div></div>
</article><%@ include file="pie.jspf" %>
